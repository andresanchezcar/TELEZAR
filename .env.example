# Copie este archivo a ".env" y ajuste los valores
SECRET_KEY=cambie-est-clave-larga-y-aleatoria
FLASK_DEBUG=1

# Por defecto la app usa SQLite (instance/telezarcomunicaciones.db).
# Solo defina DATABASE_URL si desea usar MySQL en lugar de SQLite:
#DATABASE_URL=mysql+pymysql://usuario:clave@host:3306/telezarcomunicaciones?charset=utf8mb4


# Usuario administrador inicial (solo se usa en el primer "python seed.py")
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@telezarcomunicaciones.com
